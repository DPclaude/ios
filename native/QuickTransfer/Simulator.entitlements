<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Simulator-only local namespace; never used by the device IPA or a provisioning profile. -->
    <key>application-identifier</key>
    <string>QTLOCAL001.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>keychain-access-groups</key>
    <array><string>QTLOCAL001.$(PRODUCT_BUNDLE_IDENTIFIER)</string></array>
    <key>get-task-allow</key>
    <true/>
</dict>
</plist>
